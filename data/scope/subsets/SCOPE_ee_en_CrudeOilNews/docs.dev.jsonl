{"doc_id": "CrudeOilNews__2689ceb90b951d1451b0e9224098d972800d1d7a", "text": "Although the index is up by more than 2.5 % since the Brexit outcome , it is still down approximately 4 % from its peak of 100.55 in early-December .", "language": "en", "source_dataset": "CrudeOilNews", "category": null, "global_split": "dev", "relations": [], "events": [{"event_type": "MOVEMENT-DOWN-LOSS", "trigger": {"text": "down", "pos": ""}, "arguments": [{"role": "DIFFERENCE", "text": "approximately 4 %"}]}, {"event_type": "MOVEMENT-UP-GAIN", "trigger": {"text": "up", "pos": ""}, "arguments": [{"role": "DIFFERENCE", "text": "more than 2.5 %"}, {"role": "ITEM", "text": "index"}]}, {"event_type": "POSITION-HIGH", "trigger": {"text": "peak", "pos": ""}, "arguments": [{"role": "FINAL_VALUE", "text": "100.55"}, {"role": "REFERENCE_POINT_TIME", "text": "early-December"}]}]}
{"doc_id": "CrudeOilNews__9d71b8143d760b5020a2d8b49d43a715f64838bb", "text": "Elsewhere in Europe , German industrial production dropped 1.8 % in September , well beyond expectations for a 0.5 % decline .", "language": "en", "source_dataset": "CrudeOilNews", "category": null, "global_split": "dev", "relations": [], "events": [{"event_type": "MOVEMENT-DOWN-LOSS", "trigger": {"text": "dropped", "pos": ""}, "arguments": [{"role": "TYPE", "text": "German"}, {"role": "ITEM", "text": "industrial"}, {"role": "ATTRIBUTE", "text": "production"}, {"role": "DIFFERENCE", "text": "1.8 %"}, {"role": "REFERENCE_POINT_TIME", "text": "September"}]}, {"event_type": "MOVEMENT-DOWN-LOSS", "trigger": {"text": "decline", "pos": ""}, "arguments": [{"role": "DIFFERENCE", "text": "0.5 %"}]}]}
