{"doc_id": "CrudeOilNews__f06387fbb9617499c2afe6be7daf66e52cb1cf00", "text": "Energy prices came under pressure after the Department of Labor said Friday that the U.S. economy added just 69,000 jobs in May , the smallest increase in a year and far below expectations for a gain of 150,000 .", "language": "en", "source_dataset": "CrudeOilNews", "category": null, "global_split": "dev", "relations": [], "events": [{"event_type": "MOVEMENT-UP-GAIN", "trigger": {"text": "added", "pos": ""}, "arguments": [{"role": "REFERENCE_POINT_TIME", "text": "Friday"}, {"role": "SUPPLIER_CONSUMER", "text": "U.S."}, {"role": "ITEM", "text": "economy"}, {"role": "DIFFERENCE", "text": "69,000"}, {"role": "REFERENCE_POINT_TIME", "text": "May"}]}, {"event_type": "MOVEMENT-UP-GAIN", "trigger": {"text": "increase", "pos": ""}, "arguments": [{"role": "DURATION", "text": "a year"}]}, {"event_type": "MOVEMENT-UP-GAIN", "trigger": {"text": "gain", "pos": ""}, "arguments": [{"role": "FINAL_VALUE", "text": "150,000"}]}]}
