{"doc_id": "CrudeOilNews__a653aee409db31e7d6c39a9d39a854fc667f3613", "text": "The EIA said U.S. crude inventories rose by 7.97 million barrels in the week to Jan. 18 , compared to forecasts for a stockpile draw of 0.042 million barrels .", "language": "en", "source_dataset": "CrudeOilNews", "category": null, "global_split": "dev", "relations": [], "events": [{"event_type": "CAUSE-MOVEMENT-DOWN-LOSS", "trigger": {"text": "draw", "pos": ""}, "arguments": [{"role": "ATTRIBUTE", "text": "stockpile"}, {"role": "DIFFERENCE", "text": "0.042 million barrels"}, {"role": "FORECAST", "text": "forecasts"}]}, {"event_type": "MOVEMENT-UP-GAIN", "trigger": {"text": "rose", "pos": ""}, "arguments": [{"role": "FORECASTER", "text": "EIA"}, {"role": "SUPPLIER_CONSUMER", "text": "U.S."}, {"role": "ITEM", "text": "crude"}, {"role": "ATTRIBUTE", "text": "inventories"}, {"role": "DIFFERENCE", "text": "7.97 million barrels"}, {"role": "REFERENCE_POINT_TIME", "text": "the week to Jan. 18"}]}]}
